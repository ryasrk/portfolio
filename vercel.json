{
  "cleanUrls": true,
  "functions": {
    "api/login.py": {
      "maxDuration": 15
    },
    "api/session.py": {
      "maxDuration": 15
    },
    "api/health.py": {
      "maxDuration": 15
    },
    "api/content.py": {
      "maxDuration": 30
    },
    "api/upload-image.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/data/content.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}